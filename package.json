{
  "name": "convert-everything",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "overrides": {
    "brace-expansion": "1.1.18",
    "flatted": "3.4.2",
    "nanoid": "3.3.18",
    "picomatch": "4.0.4",
    "postcss": "8.5.18",
    "vite": "7.3.6"
  },
  "scripts": {
    "predev": "node scripts/sync-runtime-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-runtime-assets.mjs",
    "build": "vite build && node scripts/generate-service-worker.mjs && node scripts/check-bundle-budget.mjs",
    "build:site": "bun run scripts/build-site.mjs",
    "generate:notices": "node scripts/generate-third-party-notices.mjs",
    "check:notices": "node scripts/generate-third-party-notices.mjs --check",
    "validate:public-config": "bun run scripts/validate-public-config.mjs",
    "validate:release-source": "bun run scripts/validate-release-source.mjs",
    "build:release": "bun run scripts/build-release.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "pretest:e2e": "bun run build",
    "test:e2e": "node ./node_modules/playwright/cli.js test",
    "test:e2e:install": "node ./node_modules/playwright/cli.js install chromium firefox webkit",
    "test:runtime-artifacts": "node scripts/assert-runtime-artifacts.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify": "bun run lint && bun run test:run && bun run build && bun run test:runtime-artifacts",
    "verify:release": "bun run verify && bun run test:e2e && bun run build:release && bun run check:bundle && bun audit --audit-level=high"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "acorn": "8.16.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
